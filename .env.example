# Скопируйте этот файл в .env и заполните реальными значениями.
# .env исключён из git — секреты никогда не попадут в репозиторий.

ADMIN_PASSWORD=
ADMIN_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Почта для уведомлений о заявках (SMTP, порт 587 / STARTTLS).
# Для Gmail: SMTP_USER — ваш ящик, SMTP_PASSWORD — пароль приложения
# (нужна двухфакторная аутентификация), SMTP_HOST=smtp.gmail.com.
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=postsonya684@gmail.com

# Только для продового запуска (docker-compose.prod.yml) — домен сайта,
# на него Caddy сам выпустит и обновит HTTPS-сертификат (Let's Encrypt).
DOMAIN=
