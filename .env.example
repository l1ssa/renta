# Скопируйте этот файл в .env и заполните реальными значениями.
# .env исключён из git — секреты никогда не попадут в репозиторий.

ADMIN_PASSWORD=
ADMIN_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Секретный адрес админки. По умолчанию admin (/admin). Лучше задать свой,
# только латиница, цифры и дефис, например: ADMIN_PATH=manager-k7q2x9vt
# После смены пересоберите frontend: docker compose ... up -d --build frontend
ADMIN_PATH=admin

# Почта для уведомлений о заявках (SMTP, порт 587 / STARTTLS).
# Для mail.ru: SMTP_USER — ваш ящик, SMTP_PASSWORD — пароль приложения.
SMTP_USER=
SMTP_PASSWORD=
SMTP_TO=elenavladimirovnakaz@mail.ru

# Только для продового запуска (docker-compose.prod.yml) — домен сайта,
# на него Caddy сам выпустит и обновит HTTPS-сертификат (Let's Encrypt).
DOMAIN=

# Публичный адрес сайта для sitemap.xml и robots.txt. Меняйте, только если
# домен другой; по умолчанию уже https://рента-пермь.рф.
NEXT_PUBLIC_SITE_URL=https://рента-пермь.рф

# Код подтверждения прав на сайт в Яндекс.Вебмастере. Добавьте сайт на
# webmaster.yandex.ru, выберите способ подтверждения «Мета-тег» — Яндекс
# покажет код вида <meta name="yandex-verification" content="КОД">,
# сюда впишите только КОД. После добавления пересоберите frontend:
# docker compose ... up -d --build frontend, затем нажмите «Проверить» в Вебмастере.
YANDEX_VERIFICATION=
